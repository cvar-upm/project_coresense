# generate_mission.yaml.example
# Copy and edit this file, then run:
#   python3 generate_mission.py my_spec.yaml             # generate files
#   python3 generate_mission.py my_spec.yaml --dry-run   # preview without writing
#   python3 generate_mission.py my_spec.yaml --run       # generate + run immediately

name: my_experiment

arena:
  half: 10.0          # arena spans [-half, half] on both axes (metres)

drones:
  count: 5
  start:
    strategy: left_edge   # 'left_edge' — evenly spaced along y at a fixed x
    x: -10.0
    # strategy: custom
    # positions:
    #   - {x: -10.0, y:  6.0}
    #   - {x: -10.0, y:  0.0}

areas:
  # ---- grid_areas: divide arena into rows×cols equal rectangles ----
  layout: grid_areas
  rows: 2
  cols: 3
  prefix: area          # area_A1, area_A2, area_B1, ...

  # ---- strip_areas: N equal parallel strips ----
  # layout: strip_areas
  # count: 5
  # axis: y             # 'y' = horizontal strips, 'x' = vertical strips
  # prefix: strip

  # ---- custom: explicit polygon vertices ----
  # layout: custom
  # polygons:
  #   - name: north_field
  #     vertices:
  #       - {x: -10, y:  0}
  #       - {x:  10, y:  0}
  #       - {x:  10, y: 10}
  #       - {x: -10, y: 10}
  #   - name: south_field
  #     vertices:
  #       - {x: -10, y: -10}
  #       - {x:  10, y: -10}
  #       - {x:  10, y:   0}
  #       - {x: -10, y:   0}

mission:
  takeoff_height: 1.0

output:
  world_dir:   config/
  mission_dir: missions/

# ---- optional: coverage and SDF parameters ----
# street_spacing, wp_space, height, and speed are written into the mission YAML
# layers so the planner uses them at runtime.  output_dir triggers SDF generation
# (a Gazebo world with a solar_panel model at each coverage waypoint).
world:
  street_spacing: 1.0              # metres between coverage streets
  wp_space:       1.0              # metres between waypoints along each street
  height:         5.0              # coverage flight height (m)
  speed:          2.0              # coverage flight speed (m/s)
  # output_dir: assets/worlds/    # uncomment to generate <name>.sdf

# ---- optional: experiment execution config ----
# Embedded into the generated <name>_experiments.yaml so --run works correctly.
# experiment:
#   mode: centralized           # 'centralized' (default) | 'decentralized'
#   times: 3                    # repeat N times; table shows mean±std
#   failure:                    # failure injection
#     drone: drone0
#     at_waypoint: 3            # centralized: trigger at waypoint N
#     # delay: 20.0             # decentralized: trigger after N seconds

# ---- optional: parametric sweep ----
# sweep:
#   - param: drones.count
#     values: [3, 5, 7]
#   - param: areas.rows
#     values: [2, 3, 4]
