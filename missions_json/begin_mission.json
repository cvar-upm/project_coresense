{
  "_comment": "2-drone auction mission. drone0: takeoff+auction, drone1: takeoff only. World: config/world.yaml. Launch: ./launch_as2.bash -w config/world.yaml",
  "mission_id": 0,
  "drones": {
    "drone0": [
      {"behavior": "takeoff", "args": {"height": 1.0, "speed": 0.7}},
      {"behavior": "auction", "args": {
        "name": "point_assignment",
        "auction_type": "coordinate_item",
        "bidders": ["drone0", "drone1"],
        "elements": [
          {"name": "point_A", "feature_names": ["x", "y"], "features": [ 3.0,  10.0]},
          {"name": "point_B", "feature_names": ["x", "y"], "features": [ 7.0,  10.0]},
          {"name": "point_C", "feature_names": ["x", "y"], "features": [ 7.0, -10.0]},
          {"name": "point_D", "feature_names": ["x", "y"], "features": [10.0, -10.0]},
          {"name": "point_E", "feature_names": ["x", "y"], "features": [10.0,   0.0]},
          {"name": "point_F", "feature_names": ["x", "y"], "features": [-2.0,  10.0]},
          {"name": "point_G", "feature_names": ["x", "y"], "features": [-6.0,  10.0]},
          {"name": "point_H", "feature_names": ["x", "y"], "features": [-6.0, -10.0]},
          {"name": "point_I", "feature_names": ["x", "y"], "features": [-10.0, -10.0]},
          {"name": "point_J", "feature_names": ["x", "y"], "features": [-10.0,   0.0]}
        ]
      }}
    ],
    "drone1": [
      {"behavior": "takeoff", "args": {"height": 1.0, "speed": 0.7}}
    ]
  }
}
